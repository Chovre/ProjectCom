# ===================================================================
# LedgerLine Environment Configuration Template
# ===================================================================

# Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/ledgerline_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgresql_password_here

# JWT Secret (minimum 256-bit secret key)
JWT_SECRET=ledgerline-super-secret-key-for-jwt-token-generation-minimum-256-bits-long
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server Port
SERVER_PORT=8081

# Frontend URL for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

